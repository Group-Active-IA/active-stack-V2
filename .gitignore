# Binaries (incluye los cross-platform que emiten los build scripts:
# active-stack_linux_amd64, active-stack_windows_amd64.exe, active-stack_darwin_arm64, etc.)
/active-stack
/active-stack_*
*.exe
*.dll
*.so
*.dylib

# Test binary / coverage
*.test
*.out

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Dist
dist/
*.tar

# Agent tooling metadata (generated per-user, not product code)
.atl/
.engram/

# OpenSpec working artifacts — we dogfood the methodology on this repo;
# the dev-process changes/specs and generated tool commands are not part
# of the product
/openspec/*
!/openspec/changes/
/openspec/changes/*
!/openspec/changes/*/
/openspec/changes/*/*
!/openspec/changes/*/informes/
!/openspec/changes/archive/
/openspec/changes/archive/*
!/openspec/changes/archive/*/
/openspec/changes/archive/*/*
!/openspec/changes/archive/*/informes/

# internal/reports (propose 2026-10-23-fase-2-pasos-1-4.md §2a): un informe
# en el que el escaneo de secretos encontró algo queda RETENIDO — el
# original nunca entra al árbol versionado, sólo su manifiesto (sin el
# valor). Vive local bajo .retenidos/ en cualquier nivel dentro de
# informes/, activo o archivado.
**/informes/**/.retenidos/

.claude/
.opencode/
